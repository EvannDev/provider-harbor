// Observe checks whether the external {{ .Env.KIND }} resource exists and is up to date.
func (c *external) Observe(ctx context.Context, mg resource.Managed) (managed.ExternalObservation, error) {
	{{ .Env.KIND | strings.ToLower }}Resource, ok := mg.(*{{ .Env.APIVERSION | strings.ToLower }}.{{ .Env.KIND }})
	if !ok {
		return managed.ExternalObservation{}, errors.New(errNot{{ .Env.KIND }})
	}

	externalName := meta.GetExternalName({{ .Env.KIND | strings.ToLower }}Resource)
	if externalName == "" {
		return managed.ExternalObservation{
			ResourceExists: false,
		}, nil
	}

	var observation {{ .Env.APIVERSION | strings.ToLower }}.{{ .Env.KIND }}Observation

	// Use c.client to fetch the {{ .Env.KIND }} from the Harbor API and populate observation.
	{{ .Env.KIND | strings.ToLower }}Resource.Status.AtProvider = observation

	former := {{ .Env.KIND | strings.ToLower }}Resource.Spec.ForProvider.DeepCopy()
	{{ .Env.GROUP | strings.ToLower }}.LateInitialize{{ .Env.KIND }}(&{{ .Env.KIND | strings.ToLower }}Resource.Spec.ForProvider, &{{ .Env.KIND | strings.ToLower }}Resource.Status.AtProvider)

	{{ .Env.KIND | strings.ToLower }}Resource.SetConditions(xpv1.Available())

	return managed.ExternalObservation{
		ResourceExists:          true,
		ResourceUpToDate:        {{ .Env.GROUP | strings.ToLower }}.Is{{ .Env.KIND }}UpToDate(&{{ .Env.KIND | strings.ToLower }}Resource.Spec.ForProvider, &{{ .Env.KIND | strings.ToLower }}Resource.Status.AtProvider),
		ResourceLateInitialized: !{{ .Env.GROUP | strings.ToLower }}.Is{{ .Env.KIND }}LateInitialized(former, &{{ .Env.KIND | strings.ToLower }}Resource.Spec.ForProvider),
		ConnectionDetails:       managed.ConnectionDetails{},
	}, nil
}

